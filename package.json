{
  "name": "browser-code-snippets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint --deny-warnings src tests snippets vite.config.ts",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.6",
    "jsdom": "26.1.0",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "idb": "8.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
